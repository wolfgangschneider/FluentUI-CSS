@page "/tablist"
@{
    string controlName = "TabList";
}
<h1>@controlName</h1>

<p>
    <a href="https://storybooks.fluentui.dev/web-components/?path=/docs/components-tablist--docs" target="_blank">See on Web Components v3</a>
</p>

<h2>TabList</h2>

<Showcase>
    <div class="tablist">
        <InputRadioGroup @bind-Value="@value1">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio Value="@((int)fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </div>
</Showcase>

<h3>Disabled</h3>
<Showcase>
    <div class="tablist">
        <InputRadioGroup Name="tablist-disabled" @bind-Value="@value1">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio disabled Value="@((int)fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </div>
</Showcase>

<h2>Vertical</h2>
<Showcase>
    <div class="tablist tablist--orientation-vertical">
        <InputRadioGroup @bind-Value="@value2">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio Value="@((int)fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </div>
</Showcase>

<h3>Vertical Disabled</h3>
<Showcase>
    <div class="tablist tablist--orientation-vertical">
        <InputRadioGroup Name="tablist-vertical-disabled" @bind-Value="@value2">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio disabled Value="@((int)fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </div>
</Showcase>
