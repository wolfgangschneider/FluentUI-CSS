@page "/switch"
@{
    string controlName = "InputCheckbox";
}
<h1>@controlName</h1>

<p>
    <a href="https://web-components.fluentui.dev/?path=/docs/components-checkbox--docs" target="_blank">See on Web Components v3</a>
</p>
<Showcase>
    <label>
        <InputCheckbox role="switch" @bind-Value="@value" />
    </label>
</Showcase>
<h2>STORIES</h2>

<h3>Default</h3>
<Showcase>
    
    <label>
        <InputCheckbox role="switch" @bind-Value="@value" />
        @controlName
    </label>
</Showcase>

<h3>Without label</h3>
<Showcase>
    <label>
        <InputCheckbox role="switch" @bind-Value="@value" />
    </label>

</Showcase>

<h3>Disabled</h3>
<Showcase>
    <label>
        <InputCheckbox role="switch" disabled @bind-Value="@value" />
        Disabled  @controlName
    </label>

    
</Showcase>



<h3>Invalid</h3>
<Showcase>
    <label>
        <InputCheckbox role="switch" class="invalid" @bind-Value="@value" />
        Invalied  @controlName Blazor (class .invalid)
    </label>

 
    <label>
        <input type="checkbox" role="switch" required />
        Invalied  @controlName CSS :invalid
    </label>
</Showcase>

@code {
    bool value;
   

}

