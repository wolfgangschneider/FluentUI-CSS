<Showcase>
    <fieldset disabled>
        <legend>@controlName disabled</legend>
        <InputRadioGroup @bind-Value="@value5">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio value="@((int)@fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </fieldset>
