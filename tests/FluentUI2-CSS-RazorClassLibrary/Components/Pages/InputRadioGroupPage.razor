@page "/inputRadioGroup"
@{
    string controlName = "InputRadioGroup";
}
<h1>@controlName</h1>

<p>
    <a href="https://web-components.fluentui.dev/?path=/docs/components-radiogroup--docs" target="_blank">See on Web Components v3</a>
</p>
<Showcase>
    <fieldset>
        <legend>@controlName</legend>
        <InputRadioGroup @bind-Value="@value1">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio value="@((int)@fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </fieldset>
</Showcase>
<h2>STORIES</h2>

<h3>Default</h3>
<Showcase>
    <fieldset>
        <legend>@controlName</legend>
        <InputRadioGroup @bind-Value="@value2">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio value="@((int)@fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </fieldset>
</Showcase>
<h3>Vertical</h3>
<Showcase>
    <fieldset class="radiogroup--orientation-vertical">
        <legend>@controlName Vertical</legend>
        <InputRadioGroup @bind-Value="@value3">
            @foreach (var fruit in Enum.GetValues(typeof(Fruits)))
            {
                <label><InputRadio value="@((int)@fruit)" />@fruit</label>
            }
        </InputRadioGroup>
    </fieldset>
</Showcase>

<h3>Without label</h3>
<Showcase>
    <fieldset>
